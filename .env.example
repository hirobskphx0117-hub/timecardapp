# 管理画面のログインパスワード（必須）
ADMIN_PASSWORD=

# 管理者セッションCookieの署名に使う秘密の文字列（必須・ランダムな長い文字列を設定）
SESSION_SECRET=

# データベース接続先
# ローカル開発: 未設定でOK（./data/timecard.db が自動的に使われます）
# 本番(Vercel): Turso (https://turso.tech) などlibSQL互換のデータベースURLを設定
# 例: libsql://your-db-name.turso.io
DATABASE_URL=

# DATABASE_URL がリモート(libsql://...)の場合のみ必要
DATABASE_AUTH_TOKEN=
